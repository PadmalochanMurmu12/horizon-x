<file path="client/src/services/api.js">
import axios from 'axios';

/**
 * Horizon-X Centralized API Configuration & Endpoints Service
 * Standardizes communication for both Admin Control Desk and Public/User Client.
 * Supports configurable VITE_API_BASE_URL for seamless local development, 
 * sandbox testing, and cloud deployments (Vercel, Render).
 */

export const API_BASE_URL = (import.meta.env.VITE_API_BASE_URL || 'http://localhost:5000/api').replace(/\/+$/, '');

// ==========================================
// 1. ADMIN PANEL ENDPOINTS
// ==========================================
export const ADMIN_ENDPOINTS = {
  // Authentication
  LOGIN: `${API_BASE_URL}/admin/login`,
  FORGOT_PASSWORD: `${API_BASE_URL}/admin/forgot-password`,
  RESET_PASSWORD: `${API_BASE_URL}/admin/reset-password`,

  // Operations & Hub Telemetry
  CITIES: `${API_BASE_URL}/cities`,
  AIRPORTS: `${API_BASE_URL}/airports`,
  AIRLINES: `${API_BASE_URL}/airlines`,
  FLIGHTS: `${API_BASE_URL}/flights`,
  UPDATE_FLIGHT_STATUS: (id) => `${API_BASE_URL}/admin/flights/${encodeURIComponent(id)}/status`,
  USERS: `${API_BASE_URL}/users`,
  BOOKINGS: `${API_BASE_URL}/bookings`,
  DELETE_BOOKING: (pnr) => `${API_BASE_URL}/admin/bookings/${encodeURIComponent(pnr)}`,

  // Fare & Fee Engine Configuration
  FEE_CONFIG: `${API_BASE_URL}/admin/fee-config`,
  UPDATE_PRICE: `${API_BASE_URL}/admin/update-price`,

  // Ground Control Operations
  COMPLETE_BOOKING: (pnr) => `${API_BASE_URL}/admin/bookings/${encodeURIComponent(pnr)}/complete`
};

// ==========================================
// 2. USER PANEL & PUBLIC RADAR ENDPOINTS
// ==========================================
export const USER_ENDPOINTS = {
  // System & Health
  HEALTH: `${API_BASE_URL}/health`,

  // Reference Master Catalogs
  AIRPORTS: `${API_BASE_URL}/airports`,
  AIRLINES: `${API_BASE_URL}/airlines`,

  // Public Flight Radar (Zero Auth Required)
  FLIGHT_STATUS: `${API_BASE_URL}/flight-status`,
  FLIGHTS_STATUS_ALIAS: `${API_BASE_URL}/flights/status`,

  // Flight Search & Itinerary
  SEARCH_ITINERARY: `${API_BASE_URL}/itinerary`,
  FEE_CONFIG: `${API_BASE_URL}/fee-config`,

  // Checkout & Payment
  CREATE_CHECKOUT_SESSION: `${API_BASE_URL}/checkout/create-session`,
  CONFIRM_CHECKOUT: `${API_BASE_URL}/checkout/confirm`,

  // Bookings & Reservation Manifest
  BOOKINGS: `${API_BASE_URL}/bookings`,
  BOOKINGS_MY_ALIAS: `${API_BASE_URL}/bookings/my-bookings`,
  BOOKING_BY_PNR: (pnr) => `${API_BASE_URL}/bookings/${encodeURIComponent(pnr)}`,

  // Document Manifest (E-Ticket & Boarding Pass)
  TICKET: (pnr, format = 'json', download = false) => 
    `${API_BASE_URL}/bookings/${encodeURIComponent(pnr)}/ticket?format=${format}${download ? '&download=true' : ''}`,
  
  BOARDING_PASS: (pnr, format = 'json', download = false) => 
    `${API_BASE_URL}/bookings/${encodeURIComponent(pnr)}/boarding-pass?format=${format}${download ? '&download=true' : ''}`,

  // Web Check-in Desk
  WEB_CHECKIN: `${API_BASE_URL}/checkin/web-checkin`,
  CANCEL_CHECKIN: `${API_BASE_URL}/checkin/cancel`,

  // Cancellation & Refunds
  CANCELLATION_REASONS: `${API_BASE_URL}/cancellation/reasons`,
  CANCEL_BOOKING: `${API_BASE_URL}/cancellation/cancel`,

  // User Authentication & Profile
  AUTH_REGISTER: `${API_BASE_URL}/auth/register`,
  AUTH_LOGIN: `${API_BASE_URL}/auth/login`,
  AUTH_SEND_OTP: `${API_BASE_URL}/auth/send-otp`,
  AUTH_OTP_LOGIN: `${API_BASE_URL}/auth/otp-login`,
  AUTH_FORGOT_PASSWORD: `${API_BASE_URL}/auth/forgot-password`,
  AUTH_RESET_PASSWORD: `${API_BASE_URL}/auth/reset-password`,
  USER_PROFILE: `${API_BASE_URL}/users/profile`,
  USER_WALLET: `${API_BASE_URL}/users/wallet`,
  USER_DELETE: `${API_BASE_URL}/users`
};

// ==========================================
// 3. ADMIN API HELPER CLIENT
// ==========================================
export const adminApi = {
  login: async (username, password) => {
    const res = await axios.post(ADMIN_ENDPOINTS.LOGIN, { username, password });
    return res.data;
  },

  forgotPassword: async (email) => {
    const res = await axios.post(ADMIN_ENDPOINTS.FORGOT_PASSWORD, { email });
    return res.data;
  },

  resetPassword: async (email, otp, newPassword) => {
    const res = await axios.post(ADMIN_ENDPOINTS.RESET_PASSWORD, { email, otp, newPassword });
    return res.data;
  },

  getHubData: async (token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const [citiesRes, flightsRes, usersRes, bookingsRes] = await Promise.all([
      axios.get(ADMIN_ENDPOINTS.CITIES, config),
      axios.get(ADMIN_ENDPOINTS.FLIGHTS, config),
      axios.get(ADMIN_ENDPOINTS.USERS, config),
      axios.get(ADMIN_ENDPOINTS.BOOKINGS, config).catch(() => ({ data: { data: [] } }))
    ]);

    return {
      cities: citiesRes.data,
      flights: flightsRes.data,
      users: usersRes.data,
      bookings: bookingsRes.data?.data || []
    };
  },

  markBookingComplete: async (pnr, token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const res = await axios.put(ADMIN_ENDPOINTS.COMPLETE_BOOKING(pnr), {}, config);
    return res.data;
  },

  getFeeConfig: async (token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const res = await axios.get(ADMIN_ENDPOINTS.FEE_CONFIG, config);
    return res.data;
  },

  updateFeeConfig: async (payload, token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const res = await axios.put(ADMIN_ENDPOINTS.UPDATE_PRICE, payload, config);
    return res.data;
  },

  getAirlines: async () => {
    const res = await axios.get(ADMIN_ENDPOINTS.AIRLINES);
    return res.data;
  },

  updateFlightStatus: async (flightId, status, token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const res = await axios.put(ADMIN_ENDPOINTS.UPDATE_FLIGHT_STATUS(flightId), { status }, config);
    return res.data;
  },

  deleteBooking: async (pnr, token) => {
    const config = { headers: { Authorization: token || sessionStorage.getItem('hx_admin_token') } };
    const res = await axios.delete(ADMIN_ENDPOINTS.DELETE_BOOKING(pnr), config);
    return res.data;
  }
};

// ==========================================
// 4. USER API HELPER CLIENT
// ==========================================
export const userApi = {
  getAirports: async () => {
    const res = await axios.get(USER_ENDPOINTS.AIRPORTS);
    return res.data;
  },

  getFlightStatus: async (params = {}) => {
    const res = await axios.get(USER_ENDPOINTS.FLIGHT_STATUS, { params });
    return res.data;
  },

  searchItinerary: async (payload) => {
    const res = await axios.post(USER_ENDPOINTS.SEARCH_ITINERARY, payload);
    return res.data;
  },

  createCheckoutSession: async (payload) => {
    const res = await axios.post(USER_ENDPOINTS.CREATE_CHECKOUT_SESSION, payload);
    return res.data;
  },

  confirmCheckout: async (sessionId) => {
    const res = await axios.post(USER_ENDPOINTS.CONFIRM_CHECKOUT, { sessionId });
    return res.data;
  },

  getBookings: async (contactEmail) => {
    const res = await axios.get(USER_ENDPOINTS.BOOKINGS, {
      params: contactEmail ? { contactEmail } : {}
    });
    return res.data;
  },

  getBookingByPnr: async (pnr) => {
    const res = await axios.get(USER_ENDPOINTS.BOOKING_BY_PNR(pnr));
    return res.data;
  },

  webCheckin: async (payload) => {
    const res = await axios.post(USER_ENDPOINTS.WEB_CHECKIN, payload);
    return res.data;
  },

  cancelCheckin: async (payload) => {
    const res = await axios.post(USER_ENDPOINTS.CANCEL_CHECKIN, payload);
    return res.data;
  },

  getCancellationReasons: async () => {
    const res = await axios.get(USER_ENDPOINTS.CANCELLATION_REASONS);
    return res.data;
  },

  cancelBooking: async (payload) => {
    const res = await axios.post(USER_ENDPOINTS.CANCEL_BOOKING, payload);
    return res.data;
  },

  getWalletBalance: async (userToken) => {
    const res = await axios.get(USER_ENDPOINTS.USER_WALLET, {
      headers: { Authorization: `Bearer ${userToken}` }
    });
    return res.data;
  },

  forgotPassword: async (identifier) => {
    const res = await axios.post(USER_ENDPOINTS.AUTH_FORGOT_PASSWORD, { identifier });
    return res.data;
  },

  resetPassword: async (identifier, otp, newPassword) => {
    const res = await axios.post(USER_ENDPOINTS.AUTH_RESET_PASSWORD, { identifier, otp, newPassword });
    return res.data;
  }
};

export default {
  API_BASE_URL,
  ADMIN_ENDPOINTS,
  USER_ENDPOINTS,
  adminApi,
  userApi
};
</file>

<file path="client/src/App.jsx">
import React, { useState } from 'react';
import { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';
import LandingPage from './pages/LandingPage';
import FlightItineraryPage from './pages/FlightItineraryPage';
import CheckoutPage from './pages/CheckoutPage';
import BookingSuccessPage from './pages/BookingSuccessPage';
import SignUpPage from './pages/SignUpPage';
import SignInPage from './pages/SignInPage';
import ForgotPasswordPage from './pages/ForgotPasswordPage';
import MyBookingsPage from './pages/MyBookingsPage';
import AdminLogin from './pages/admin/AdminLogin';
import AdminDashboard from './pages/admin/AdminDashboard';
import { USER_ENDPOINTS } from './services/api';
import { ThemeProvider } from './context/ThemeContext';

function App() {
  const [token, setToken] = useState(() => sessionStorage.getItem('hx_admin_token'));

  const updateToken = (newToken) => {
    if (newToken) {
      sessionStorage.setItem('hx_admin_token', newToken);
    } else {
      sessionStorage.removeItem('hx_admin_token');
    }
    setToken(newToken);
  };

  const handleFlightSearch = async (searchPayload) => {
    try {
      console.log('Dispatching Search Payload:', searchPayload);
      const res = await fetch(USER_ENDPOINTS.SEARCH_ITINERARY, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(searchPayload)
      });
      const data = await res.json();
      console.log('Search Results from Backend:', data);
    } catch (err) {
      console.error('Search request failed:', err);
    }
  };

  return (
    <ThemeProvider>
      <BrowserRouter>
        <Routes>
          {/* Public Flight Search Engine & Itinerary */}
          <Route path="/" element={<LandingPage onSearch={handleFlightSearch} />} />
          <Route path="/flights" element={<FlightItineraryPage />} />
          <Route path="/itinerary" element={<FlightItineraryPage />} />
          <Route path="/search" element={<FlightItineraryPage />} />

          {/* Passenger Details, Booking & Checkout Session */}
          <Route path="/checkout" element={<CheckoutPage />} />
          <Route path="/booking/checkout" element={<CheckoutPage />} />
          <Route path="/booking/cancelled" element={<Navigate to="/checkout?cancelled=true" replace />} />
          <Route path="/booking/success" element={<BookingSuccessPage />} />
          <Route path="/booking/confirmation" element={<BookingSuccessPage />} />

          {/* User Fast Passwordless Onboarding & Sign In (Cleartrip model) */}
          <Route path="/signup" element={<Navigate to="/signin" replace />} />
          <Route path="/register" element={<Navigate to="/signin" replace />} />
          <Route path="/signin" element={<SignInPage />} />
          <Route path="/login" element={<SignInPage />} />
          <Route path="/forgot-password" element={<ForgotPasswordPage isAdmin={false} />} />
          
          {/* My Bookings & Web Check-in */}
          <Route path="/bookings" element={<MyBookingsPage />} />
          <Route path="/checkin" element={<MyBookingsPage defaultTab="checkin" />} />
          
          {/* Admin Authentication & Control Panel */}
          <Route 
            path="/admin/login" 
            element={<AdminLogin token={token} setToken={updateToken} />} 
          />
          <Route 
            path="/admin/forgot-password" 
            element={<ForgotPasswordPage isAdmin={true} />} 
          />
          
          <Route 
            path="/admin/dashboard" 
            element={
              token ? (
                <AdminDashboard token={token} setToken={updateToken} />
              ) : (
                <Navigate to="/admin/login" replace />
              )
            } 
          />

          {/* Fallback Catch-All */}
          <Route path="*" element={<Navigate to="/" replace />} />
        </Routes>
      </BrowserRouter>
    </ThemeProvider>
  );
}

export default App;
</file>

<file path="client/src/index.css">
@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
  vertical-align: middle;
}
.scrollbar-hide::-webkit-scrollbar { display: none; }
.glass-effect {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}
.search-pill:hover {
  box-shadow: 0 4px 20px rgba(0, 92, 171, 0.15);
}
.input-group:focus-within {
  background-color: #f0f7ff;
}

/* =========================================================
   CINEMATIC TAKEOFF SEQUENCE (Slow roll -> Pitch up -> Sonic acceleration)
   ========================================================= */

@keyframes runwayTarmacRoll {
  0% {
    transform: translate3d(-15vw, 15vh, 0) rotate(0deg) scale(0.65);
    opacity: 0;
  }
  12% {
    opacity: 1;
    transform: translate3d(-5vw, 15vh, 0) rotate(0deg) scale(0.7);
  }
  28% {
    /* Ground Roll: Gradually picking up runway speed */
    transform: translate3d(12vw, 15vh, 0) rotate(0deg) scale(0.8);
  }
  42% {
    /* Pitch Up (V_r Rotation): Nose lifts off the ground */
    transform: translate3d(28vw, 10vh, 0) rotate(-22deg) scale(0.95);
  }
  65% {
    /* Airborne Acceleration: Climbing rapidly */
    transform: translate3d(58vw, -15vh, 0) rotate(-32deg) scale(1.35);
    opacity: 1;
  }
  100% {
    /* Supersonic Climb-out: Rocketing off-screen into the sky */
    transform: translate3d(125vw, -95vh, 0) rotate(-36deg) scale(2.4);
    opacity: 1;
  }
}

/* Runway Centerline Streaks moving backward under plane */
@keyframes runwayStripMove {
  0% { transform: translateX(0); }
  100% { transform: translateX(-300px); }
}

/* Jet Engine Exhaust Vapor Trail */
@keyframes jetThrustPulse {
  0% { opacity: 0.2; transform: scaleX(0.5); }
  50% { opacity: 0.9; transform: scaleX(1.4); }
  100% { opacity: 0.3; transform: scaleX(0.7); }
}

/* =========================================================
   CINEMATIC CRASH & EXPLOSION SEQUENCE
   ========================================================= */

/* Aircraft Stall, Steep Nose Dive, and Impact */
@keyframes planeStallAndDive {
  0% {
    transform: translate3d(0, -180px, 0) rotate(-10deg) scale(0.75);
    opacity: 0;
  }
  12% {
    opacity: 1;
    /* Stall wobble: Plane tilts left and right */
    transform: translate3d(0, -140px, 0) rotate(25deg) scale(0.85);
  }
  22% {
    /* Engine failure: Plane tips backwards then noses straight down */
    transform: translate3d(5px, -110px, 0) rotate(-35deg) scale(0.9);
  }
  32% {
    /* Steep pitch down */
    transform: translate3d(10px, -60px, 0) rotate(165deg) scale(0.95);
  }
  46% {
    /* Terminal high-speed dive towards ground runway */
    transform: translate3d(12px, 80px, 0) rotate(180deg) scale(1.05);
    opacity: 1;
  }
  49% {
    /* Ground Impact point */
    transform: translate3d(12px, 95px, 0) rotate(180deg) scale(0.05);
    opacity: 0;
  }
  100% {
    transform: translate3d(12px, 95px, 0) rotate(180deg) scale(0);
    opacity: 0;
  }
}

/* Shockwave Ring Expanding at Ground Zero */
@keyframes impactShockwave {
  0%, 48% {
    transform: scale(0);
    opacity: 0;
  }
  49% {
    transform: scale(0.2);
    opacity: 1;
  }
  68% {
    transform: scale(2.8);
    opacity: 0.8;
  }
  100% {
    transform: scale(4.2);
    opacity: 0;
  }
}

/* Outer Fiery Spiky Explosion Starburst (Geometric & Crisp) */
@keyframes explosionOuterSharp {
  0%, 48% {
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }
  50% {
    transform: scale(0.25) rotate(15deg);
    opacity: 1;
  }
  64% {
    transform: scale(1.45) rotate(45deg);
    opacity: 1;
  }
  78% {
    transform: scale(1.3) rotate(60deg);
    opacity: 0.9;
  }
  100% {
    transform: scale(0.4) rotate(90deg);
    opacity: 0;
  }
}

/* Inner Core Yellow Fireball */
@keyframes explosionCoreSharp {
  0%, 48% {
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }
  50% {
    transform: scale(0.3) rotate(-15deg);
    opacity: 1;
  }
  66% {
    transform: scale(1.55) rotate(-35deg);
    opacity: 1;
  }
  82% {
    transform: scale(0.9) rotate(-50deg);
    opacity: 0.9;
  }
  100% {
    transform: scale(0.2) rotate(-70deg);
    opacity: 0;
  }
}

/* Flying Debris Shards */
@keyframes flyingDebris {
  0%, 48% {
    transform: translate(0, 0) scale(0);
    opacity: 0;
  }
  52% {
    transform: translate(var(--tx, 30px), var(--ty, -40px)) scale(1);
    opacity: 1;
  }
  85% {
    transform: translate(calc(var(--tx, 30px) * 2.2), calc(var(--ty, -40px) * 2.2)) scale(0.8);
    opacity: 0.8;
  }
  100% {
    transform: translate(calc(var(--tx, 30px) * 3), calc(var(--ty, -40px) * 3 + 30px)) scale(0.2);
    opacity: 0;
  }
}

/* Violent Camera / Cockpit Rattle on Impact */
@keyframes heavyRattle {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  10% { transform: translate3d(-7px, 5px, 0) rotate(-1.5deg); }
  25% { transform: translate3d(7px, -6px, 0) rotate(1.5deg); }
  40% { transform: translate3d(-5px, 4px, 0) rotate(-1deg); }
  55% { transform: translate3d(5px, -3px, 0) rotate(0.8deg); }
  70% { transform: translate3d(-3px, 2px, 0) rotate(-0.5deg); }
  85% { transform: translate3d(2px, -1px, 0) rotate(0.2deg); }
}

/* Radar Pulse / Background Sweeps */
@keyframes radarPulse {
  0% { transform: scale(0.95); opacity: 0.04; }
  50% { transform: scale(1.06); opacity: 0.12; }
  100% { transform: scale(0.95); opacity: 0.04; }
}

/* Slow Spin Utility */
