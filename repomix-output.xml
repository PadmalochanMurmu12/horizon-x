/**
 * @openapi
 * /api/auth/reset-password:
 *   post:
 *     summary: Confirm password update with security verification codes
 *     tags:
 *       - User Panel
 *     requestBody:
 *       required: true
 *       content:
 *         application/json:
 *           schema:
 *             type: object
 *             required:
 *               - identifier
 *               - emailOtp
 *               - phoneOtp
 *               - newPassword
 *             properties:
 *               identifier:
 *                 type: string
 *                 example: john@example.com
 *               emailOtp:
 *                 type: string
 *                 example: "1111"
 *               phoneOtp:
 *                 type: string
 *                 example: "2222"
 *               newPassword:
 *                 type: string
 *                 example: NewPassword@123
 *     responses:
 *       200:
 *         description: Password updated
 *       401:
 *         description: Security code mismatch
 */
app.post('/api/auth/reset-password', async (req, res) => {
  try {
    const { identifier, otp, emailOtp, phoneOtp, newPassword } = req.body;

    const isSingleOtpValid = otp && String(otp).trim() === String(MOCK_OTP).trim();
    const isDualOtpValid = emailOtp === MOCK_EMAIL_OTP && phoneOtp === MOCK_PHONE_OTP;

    if (!isSingleOtpValid && !isDualOtpValid) {
      return res.status(401).json({
        error: 'Invalid or incorrect 4-digit OTP. Verification code mismatch.'
      });
    }

    if (!newPassword || newPassword.length < 8 || !/\d/.test(newPassword)) {
      return res.status(400).json({
        error: 'Password must be at least 8 characters long and contain at least one number.'
      });
    }

    const user = await User.findOne({
      where: { [Op.or]: [{ email: identifier }, { phone: identifier }] }
    });
    if (!user) {
      return res.status(404).json({ error: 'Flight manifest check: No passenger record found matching that identifier.' });
    }

    user.password = await bcrypt.hash(newPassword, 10);
    await user.save();

    res.status(200).json({
      message: 'Security credentials updated successfully. You may now proceed to check in with your new password.'
    });
  } catch (error) {
    res.status(500).json({ error: 'Encountered unexpected turbulence while updating your security credentials.' });
  }
});

