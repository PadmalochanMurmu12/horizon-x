import React, { useState, useEffect, useMemo } from 'react';
import { useNavigate, useSearchParams, Link } from 'react-router-dom';
import { useSelector, useDispatch } from 'react-redux';
import {
  setContactInfo,
  updatePassenger,
  addPassenger,
  removePassenger,
  toggleAddon,
  setPromoInput,
  applyPromoCode,
  removePromoCode,
  setReviewModalOpen,
  setSeatMapModalOpen,
  setSeatMapActivePaxIndex,
  assignSeatToPassenger,
  autoAssignSeatToPassenger,
  autoAssignAllSeats,
  clearPassengerSeat,
  setAdminFeeConfig,
  setCheckoutLoading,
  setCheckoutError,
  setBookingResult,
  setPaymentUrls,
  setPaymentSuccess,
  setPaymentDeclined,
  setSuccessModalOpen,
  setDeclinedModalOpen,
  closePaymentModals
} from '../store/bookingSlice';
