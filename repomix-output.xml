      // Other rows: Standard Free (₹0)
      const isExtraLegroom = r <= 3 || r === 11 || r === 12;
      const price = isExtraLegroom ? 1200 : 0;
      const type = isExtraLegroom ? 'extraLegroom' : 'standard';

      rows.push({
        rowNumber: r,
        isExtraLegroom,
        price,
        type,
        seatsLeft: ['A', 'B', 'C'].map(col => `${r}${col}`),
        seatsRight: ['D', 'E', 'F'].map(col => `${r}${col}`)
      });
